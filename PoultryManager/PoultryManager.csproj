<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Cibles : Android (application mobile) et Windows (test rapide sur le PC). -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>PoultryManager</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Identité de l'application -->
		<ApplicationTitle>PoultryManager</ApplicationTitle>
		<ApplicationId>com.poultrymanager.app</ApplicationId>
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>5</ApplicationVersion>

		<!-- Windows : application non empaquetée (lancement direct depuis Visual Studio). -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- Icône de l'application -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" ForegroundScale="0.6" Color="#174B35" />

		<!-- Écran de démarrage -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#174B35" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\logo.png" Resize="True" BaseSize="114,114" />
		<MauiImage Update="Resources\Images\bienvenue_fond.jpg" Resize="True" BaseSize="390,821" />
		<MauiImage Update="Resources\Images\connexion_fond.jpg" Resize="True" BaseSize="390,821" />
		<MauiImage Update="Resources\Images\ic_egg_big.svg" BaseSize="40,40" />

		<!-- Polices (Plus Jakarta Sans) -->
		<MauiFont Include="Resources\Fonts\*.ttf" />

		<!-- Ressources brutes -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
	</ItemGroup>

</Project>
