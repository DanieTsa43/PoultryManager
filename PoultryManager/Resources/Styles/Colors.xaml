<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!--
    Palette PoultryManager (voir docs/maquette/DESIGN.md, section 2).
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Verts -->
    <Color x:Key="ForestGreen">#174B35</Color>
    <Color x:Key="DeepGreen">#103A2A</Color>
    <Color x:Key="ButtonGreen">#286B46</Color>
    <Color x:Key="SageGreen">#DCE8DF</Color>
    <Color x:Key="PaleGreen">#F2F7F3</Color>

    <!-- Neutres -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>
    <Color x:Key="TextPrimary">#17392C</Color>
    <Color x:Key="TextSecondary">#7C8D82</Color>
    <Color x:Key="TextSecondarySmall">#5C7065</Color>
    <Color x:Key="TextMuted">#3F5A4C</Color>
    <Color x:Key="BorderColor">#E1EAE3</Color>

    <!-- Accents et états -->
    <Color x:Key="EggYellow">#EFCB70</Color>
    <Color x:Key="AlertRed">#C94D4D</Color>
    <Color x:Key="ErrorText">#B03E3E</Color>
    <Color x:Key="ErrorBackground">#F6E3E3</Color>

    <!-- Bandeau de rappel de saisie -->
    <Color x:Key="ReminderBackground">#FBF1D4</Color>
    <Color x:Key="ReminderText">#6B4E0E</Color>

    <!-- Couleurs semi-transparentes de l'écran de bienvenue -->
    <Color x:Key="WelcomePrimaryButton">#E6286B46</Color>
    <Color x:Key="WelcomeSecondaryButton">#B3103A2A</Color>
    <Color x:Key="WelcomeButtonBorder">#D9FFFFFF</Color>

</ResourceDictionary>
