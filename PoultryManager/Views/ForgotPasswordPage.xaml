<?xml version="1.0" encoding="utf-8" ?>
<!--
    Mot de passe oublié (depuis 01 · Connexion)
    L'application est locale : la réinitialisation se fait sur l'appareil, avec l'e-mail du compte.
-->
<base:ViewModelPage
    x:Class="PoultryManager.Views.ForgotPasswordPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:base="clr-namespace:PoultryManager.Views.Base"
    xmlns:vm="clr-namespace:PoultryManager.ViewModels"
    x:DataType="vm:ForgotPasswordViewModel"
    Title="{Binding Title}"
    Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="44,*,Auto" Style="{StaticResource HeaderGridStyle}">
            <ImageButton
                Source="icon_back.png"
                Style="{StaticResource IconButtonStyle}"
                Command="{Binding GoBackCommand}"
                SemanticProperties.Description="Retour" />
            <Label
                Grid.Column="1"
                Text="{Binding Title}"
                Style="{StaticResource ScreenTitleStyle}"
                VerticalOptions="Center"
                SemanticProperties.HeadingLevel="Level1" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,20" Spacing="12">

                <!-- Formulaire -->
                <Border Style="{StaticResource FormCardStyle}" IsVisible="{Binding ShowForm}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Choisir un nouveau mot de passe" Style="{StaticResource SectionTitleStyle}" />
                        <Label
                            Text="L'application fonctionne sur cet appareil, sans serveur. Indiquez l'adresse e-mail du compte pour remplacer le mot de passe."
                            Style="{StaticResource CaptionStyle}" />

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Adresse e-mail" Style="{StaticResource FieldLabelStyle}" />
                            <Border Style="{StaticResource FieldStyle}">
                                <Entry Text="{Binding Email}" Keyboard="Email" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Nouveau mot de passe" Style="{StaticResource FieldLabelStyle}" />
                            <Border Style="{StaticResource FieldStyle}">
                                <Entry Text="{Binding NewPassword}" Placeholder="6 caractères minimum" IsPassword="True" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="6">
                            <Label Text="Confirmer le nouveau mot de passe" Style="{StaticResource FieldLabelStyle}" />
                            <Border Style="{StaticResource FieldStyle}">
                                <Entry Text="{Binding ConfirmPassword}" IsPassword="True" VerticalOptions="Center" />
                            </Border>
                        </VerticalStackLayout>

                        <Border Style="{StaticResource ErrorBannerStyle}" IsVisible="{Binding HasError}">
                            <Grid ColumnDefinitions="20,*" ColumnSpacing="10">
                                <Image Source="ic_alert.png" WidthRequest="20" HeightRequest="20" VerticalOptions="Center" />
                                <Label Grid.Column="1" Text="{Binding ErrorMessage}" FontFamily="JakartaBold" FontSize="14" TextColor="#8E2F2F" VerticalOptions="Center" LineBreakMode="WordWrap" />
                            </Grid>
                        </Border>

                        <Button Text="Réinitialiser le mot de passe" Command="{Binding ResetPasswordCommand}" />
                    </VerticalStackLayout>
                </Border>

                <!-- Confirmation -->
                <Border Style="{StaticResource FormCardStyle}" IsVisible="{Binding IsReset}">
                    <VerticalStackLayout Spacing="14" HorizontalOptions="Center">
                        <Image Source="ic_check.png" WidthRequest="48" HeightRequest="48" HorizontalOptions="Center" />
                        <Label Text="Mot de passe remplacé" Style="{StaticResource SectionTitleStyle}" HorizontalTextAlignment="Center" />
                        <Label
                            Text="Vous pouvez maintenant vous connecter avec votre nouveau mot de passe."
                            Style="{StaticResource CaptionStyle}"
                            HorizontalTextAlignment="Center" />
                        <Button Text="Retour à la connexion" Command="{Binding GoBackCommand}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</base:ViewModelPage>
